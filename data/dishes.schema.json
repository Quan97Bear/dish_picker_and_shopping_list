{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "dishes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string" },
    "dishes": {
      "type": "array", "minItems": 40, "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "servings", "ingredients", "steps", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["vegetable", "meat", "mixed", "stew", "soup"] },
          "servings": { "type": "integer", "minimum": 1 },
          "ingredients": { "type": "array", "minItems": 1 },
          "steps": { "type": "array", "minItems": 1 },
          "source": { "type": "object", "required": ["project", "url", "license", "retrievedAt"] }
        }
      }
    }
  }
}
